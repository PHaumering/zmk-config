#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

#define BASE        0
#define NUM         1
#define FN          2
#define NAV         3

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

&mt {
    quick-tap-ms = <125>;
    flavor = "tap-preferred";
};

&lt { quick-tap-ms = <125>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "Base";
            bindings = <
         &kp Q           &kp W           &kp E               &kp R             &kp T            &kp DE_Z  &kp U              &kp I                &kp O            &kp P
         &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_CONTROL D  &mt LEFT_SHIFT F  &kp G            &kp H     &mt RIGHT_SHIFT J  &mt RIGHT_CONTROL K  &mt RIGHT_ALT L  &mt RIGHT_GUI DE_O_UMLAUT
&kp TAB  &kp DE_Y        &kp X           &kp C               &kp V             &kp B            &kp N     &kp M              &kp COMMA            &kp DOT          &kp DE_MINUS               &kp ENTER
                                         &lt 1 HOME          &kp SPACE         &kp BACKSPACE    &kp DEL   &kp SPACE          &lt 2 END
            >;
        };

        NUM {
            bindings = <
              &kp DE_N1  &kp DE_N2  &kp DE_N3  &kp DE_N4  &kp DE_N5    &kp DE_N6  &kp DE_N7  &kp DE_N8  &kp DE_N9  &kp DE_N0
              &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans
&kp DE_CARET  &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans     &kp DE_SZ
                                    &trans     &trans     &trans       &trans     &trans     &trans
            >;

            label = "Numbers";
        };

        FN {
            bindings = <
         &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6  &kp F7    &kp F8    &kp F9     &kp F10
         &trans  &trans  &trans  &trans  &trans    &trans  &kp LEFT  &kp UP    &kp RIGHT  &trans
&kp ESC  &trans  &trans  &trans  &trans  &trans    &trans  &trans    &kp DOWN  &trans     &trans   &kp F11
                         &trans  &trans  &trans    &trans  &trans    &trans
            >;

            label = "Function";
        };
    };
};
